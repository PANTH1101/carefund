@model NGODonationSystem.Models.NGO
@{
    ViewData["Title"] = "Verification Status";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header @(Model.VerificationStatus == "Approved" ? "bg-success" : Model.VerificationStatus == "Rejected" ? "bg-danger" : "bg-warning text-dark") text-white">
                    <h3 class="mb-0">NGO Verification Status</h3>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-4 fw-bold">NGO Name:</div>
                        <div class="col-md-8">@Model.Name</div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 fw-bold">Current Status:</div>
                        <div class="col-md-8">
                            @if (Model.VerificationStatus == "Approved")
                            {
                                <span class="badge bg-success fs-5">
                                    <i class="bi bi-check-circle-fill"></i> Approved
                                </span>
                            }
                            else if (Model.VerificationStatus == "Rejected")
                            {
                                <span class="badge bg-danger fs-5">
                                    <i class="bi bi-x-circle-fill"></i> Rejected
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark fs-5">
                                    <i class="bi bi-hourglass-split"></i> Pending
                                </span>
                            }
                        </div>
                    </div>

                    <hr />

                    @if (Model.VerificationStatus == "Pending")
                    {
                        <div class="alert alert-warning">
                            <h5><i class="bi bi-info-circle"></i> Verification Pending</h5>
                            <p class="mb-0">
                                Your NGO verification is currently pending. Our admin team is reviewing your registration information 
                                and verification documents. You will be notified once your verification is complete.
                            </p>
                        </div>
                        <p class="text-muted">
                            <strong>What happens next?</strong><br />
                            - Our team will review your NGO information<br />
                            - We will verify your documents<br />
                            - You will receive an update on your verification status
                        </p>
                    }
                    else if (Model.VerificationStatus == "Approved")
                    {
                        <div class="alert alert-success">
                            <h5><i class="bi bi-check-circle-fill"></i> Congratulations!</h5>
                            <p class="mb-0">
                                Your NGO has been approved! You can now access all features available to verified NGOs.
                            </p>
                        </div>
                        <p class="text-muted">
                            <strong>What you can do now:</strong><br />
                            - Create fundraising campaigns<br />
                            - Manage your NGO profile<br />
                            - Receive donations from donors
                        </p>
                        <div class="mt-3">
                            <a asp-controller="Profile" asp-action="Index" class="btn btn-primary">
                                <i class="bi bi-person"></i> View Profile
                            </a>
                        </div>
                    }
                    else if (Model.VerificationStatus == "Rejected")
                    {
                        <div class="alert alert-danger">
                            <h5><i class="bi bi-exclamation-triangle-fill"></i> Verification Rejected</h5>
                            <p class="mb-0">
                                Unfortunately, your NGO verification was rejected. This may be due to incomplete information 
                                or issues with the verification documents.
                            </p>
                        </div>
                        <p class="text-muted">
                            <strong>What should you do?</strong><br />
                            - Review your NGO information for accuracy<br />
                            - Ensure all documents are valid and clear<br />
                            - Contact our support team for more information
                        </p>
                    }

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-house"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
