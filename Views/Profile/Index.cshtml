@model NGODonationSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    var role = ViewBag.Role as string;
    var ngo = ViewBag.NGO as NGODonationSystem.Models.NGO;
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">My Profile</h3>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Full Name:</div>
                        <div class="col-md-8">@Model.FullName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Email:</div>
                        <div class="col-md-8">@Model.Email</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Phone Number:</div>
                        <div class="col-md-8">@(Model.PhoneNumber ?? "Not provided")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Role:</div>
                        <div class="col-md-8">
                            <span class="badge @(role == "Admin" ? "bg-danger" : role == "NGO" ? "bg-success" : "bg-primary")">
                                @role
                            </span>
                        </div>
                    </div>

                    @if (role == "NGO" && ngo != null)
                    {
                        <hr class="my-4" />
                        <h5 class="text-success mb-3">NGO Information</h5>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">NGO Name:</div>
                            <div class="col-md-8">@ngo.Name</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">Description:</div>
                            <div class="col-md-8">@ngo.Description</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">Contact Information:</div>
                            <div class="col-md-8">
                                <pre class="mb-0">@ngo.ContactInformation</pre>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">Verification Status:</div>
                            <div class="col-md-8">
                                <span class="badge @(ngo.VerificationStatus == "Approved" ? "bg-success" : ngo.VerificationStatus == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
                                    @ngo.VerificationStatus
                                </span>
                            </div>
                        </div>

                        @if (ngo.VerificationStatus == "Rejected")
                        {
                            <div class="alert alert-warning mt-3">
                                <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Verification Rejected</h6>
                                <p class="mb-0">
                                    Your NGO verification was rejected. You can 
                                    <a asp-action="Edit" class="alert-link">edit your profile</a> 
                                    to update your information and upload corrected verification documents for resubmission.
                                </p>
                            </div>
                        }

                        @if (ngo.Logo != null)
                        {
                            <div class="row mb-3">
                                <div class="col-md-4 fw-bold">Logo:</div>
                                <div class="col-md-8">
                                    <img src="data:@ngo.LogoContentType;base64,@Convert.ToBase64String(ngo.Logo)" 
                                         alt="NGO Logo" 
                                         class="img-thumbnail" 
                                         style="max-width: 200px; max-height: 200px;" />
                                </div>
                            </div>
                        }
                    }

                    <div class="mt-4">
                        <a asp-action="Edit" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit Profile
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-house"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
