@model NGODonationSystem.Models.Donation
@{
    ViewData["Title"] = "Donation Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-receipt"></i> Donation Details</h3>
                </div>
                <div class="card-body">
                    <!-- Receipt Number -->
                    <div class="text-center mb-4 p-3 bg-light rounded">
                        <h5 class="text-muted mb-1">Receipt Number</h5>
                        <h3 class="font-monospace text-primary">@Model.ReceiptNumber</h3>
                    </div>

                    <!-- Donation Information -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Donor Information</h6>
                            @if (Model.IsAnonymous)
                            {
                                <p class="mb-0">
                                    <i class="bi bi-eye-slash"></i> <em>Anonymous Donation</em>
                                </p>
                                <small class="text-muted">Donor chose to remain anonymous</small>
                            }
                            else
                            {
                                <p class="mb-0"><strong>@Model.Donor.FullName</strong></p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Campaign</h6>
                            <p class="mb-0"><strong>@Model.Campaign.Title</strong></p>
                            <a asp-controller="Campaign" asp-action="Details" asp-route-id="@Model.CampaignId" 
                               class="btn btn-sm btn-outline-primary mt-2">
                                <i class="bi bi-megaphone"></i> View Campaign
                            </a>
                        </div>
                    </div>

                    <hr />

                    <!-- Amount & Date -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Donation Amount</h6>
                            <h4 class="text-success mb-0">₹@Model.Amount.ToString("N2")</h4>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Donation Date</h6>
                            <p class="mb-0">@Model.DonationDate.ToString("dd MMMM yyyy")</p>
                            <small class="text-muted">@Model.DonationDate.ToString("hh:mm tt")</small>
                        </div>
                    </div>

                    <hr />

                    <!-- Status & Transaction -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Status</h6>
                            <span class="badge bg-success fs-6">
                                <i class="bi bi-check-circle"></i> @Model.Status
                            </span>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Transaction ID</h6>
                            <p class="mb-0 font-monospace small">@Model.TransactionId</p>
                        </div>
                    </div>

                    @if (Model.Payment != null)
                    {
                        <hr />
                        <div class="mb-3">
                            <h6 class="text-muted">Payment Details</h6>
                            <div class="small">
                                <p class="mb-1"><strong>Order ID:</strong> <span class="font-monospace">@Model.Payment.RazorpayOrderId</span></p>
                                <p class="mb-1"><strong>Payment ID:</strong> <span class="font-monospace">@Model.Payment.RazorpayPaymentId</span></p>
                                <p class="mb-0"><strong>Processed:</strong> @Model.Payment.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</p>
                            </div>
                        </div>
                    }

                    <!-- Actions -->
                    <div class="d-grid gap-2 mt-4">
                        <a asp-action="Received" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to All Donations
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
