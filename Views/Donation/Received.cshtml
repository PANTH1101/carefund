@model NGODonationSystem.ViewModels.ReceivedDonationsViewModel
@{
    ViewData["Title"] = "Donations Received";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-heart-fill text-danger"></i> Donations Received</h2>
            </div>

            <!-- Summary Cards -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-primary text-white shadow">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-collection"></i> Total Donations</h5>
                            <h2 class="mb-0">@Model.TotalDonations</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-success text-white shadow">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-currency-rupee"></i> Total Amount Raised</h5>
                            <h2 class="mb-0">₹@Model.TotalAmount.ToString("N2")</h2>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Donations.Any())
            {
                <div class="card shadow">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Donation History</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Donor</th>
                                        <th>Campaign</th>
                                        <th>Amount</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Receipt #</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var donation in Model.Donations)
                                    {
                                        <tr>
                                            <td>
                                                @if (donation.IsAnonymous)
                                                {
                                                    <span class="text-muted">
                                                        <i class="bi bi-eye-slash"></i> Anonymous
                                                    </span>
                                                }
                                                else
                                                {
                                                    @donation.DonorName
                                                }
                                            </td>
                                            <td>@donation.CampaignName</td>
                                            <td class="fw-bold text-success">₹@donation.Amount.ToString("N2")</td>
                                            <td>@donation.DonationDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> @donation.Status
                                                </span>
                                            </td>
                                            <td>
                                                <small class="text-muted font-monospace">@donation.ReceiptNumber</small>
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@donation.DonationId" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No donations received yet. When donors contribute to your campaigns, they will appear here.
                </div>
            }
        </div>
    </div>
</div>
