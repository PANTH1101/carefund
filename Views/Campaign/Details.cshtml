@model NGODonationSystem.Models.Campaign
@{
    ViewData["Title"] = Model.Title;
    var now = DateTime.Now;
    var raisedAmount = Model.Donations?.Where(d => d.Status == "Success" || d.Status == "Completed").Sum(d => d.Amount) ?? 0;
    var isCompleted = raisedAmount >= Model.TargetAmount;
    var isExpired = now > Model.Deadline;
    var hasDonations = Model.Donations?.Any(d => d.Status == "Success" || d.Status == "Completed") ?? false;
    var progressPercentage = Model.TargetAmount > 0 ? (int)((raisedAmount / Model.TargetAmount) * 100) : 0;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                @if (Model.Image != null)
                {
                    var base64 = Convert.ToBase64String(Model.Image);
                    <img src="data:@Model.ImageContentType;base64,@base64" class="card-img-top" alt="@Model.Title" style="max-height: 400px; object-fit: cover;">
                }
                <div class="card-body">
                    <h2>@Model.Title</h2>
                    <p class="badge bg-secondary">@Model.Category</p>
                    <p>@Model.Description</p>
                    <div class="mb-3">
                        <p><strong>Start Date:</strong> @Model.StartDate.ToString("MMM dd, yyyy")</p>
                        <p><strong>Deadline:</strong> @Model.Deadline.ToString("MMM dd, yyyy")</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5>Progress</h5>
                    <div class="progress mb-2" style="height: 25px;">
                        <div class="progress-bar" style="width: @Math.Min(progressPercentage, 100)%">@progressPercentage%</div>
                    </div>
                    <p><strong>₹@raisedAmount.ToString("N0")</strong> of ₹@Model.TargetAmount.ToString("N0")</p>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h5>Actions</h5>
                    @if (!isExpired && !isCompleted)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning w-100 mb-2">Edit</a>
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mb-2" onsubmit="return confirm('Cancel this campaign?')">
                            <button type="submit" class="btn btn-outline-danger w-100">Cancel Campaign</button>
                        </form>
                    }
                    @if (!hasDonations)
                    {
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this campaign?')">
                            <button type="submit" class="btn btn-outline-danger w-100">Delete</button>
                        </form>
                    }
                    <a asp-action="MyCampaigns" class="btn btn-secondary w-100 mt-2">Back to My Campaigns</a>
                </div>
            </div>
        </div>
    </div>
</div>
