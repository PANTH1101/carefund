@model NGODonationSystem.Models.Campaign
@{
    ViewData["Title"] = Model.Title;
    var now = DateTime.Now;
    var raisedAmount = ViewBag.RaisedAmount as decimal? ?? 0;
    var progressPercentage = (int)(ViewBag.Progress ?? 0);
    var donorCount = ViewBag.DonorCount as int? ?? 0;
    var status = ViewBag.Status as string ?? "Active";
    var daysRemaining = ViewBag.DaysRemaining as int?;
    var isCompleted = status == "Completed";
    var isExpired = status == "Expired";
    var isActive = status == "Active";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Campaigns</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4 shadow-sm">
                @if (Model.Image != null && Model.Image.Length > 0)
                {
                    var base64 = Convert.ToBase64String(Model.Image);
                    <img src="data:@Model.ImageContentType;base64,@base64" class="card-img-top" alt="@Model.Title" style="max-height: 500px; object-fit: cover;">
                }
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h2 class="card-title mb-0">@Model.Title</h2>
                        <span class="badge @(isCompleted ? "bg-success" : (isExpired ? "bg-secondary" : "bg-primary")) fs-6">@status</span>
                    </div>
                    
                    <p class="text-muted mb-3">
                        <span class="badge bg-light text-dark me-2"><i class="bi bi-tag"></i> @Model.Category</span>
                    </p>

                    <h4 class="mt-4">About This Campaign</h4>
                    <p class="card-text" style="white-space: pre-line;">@Model.Description</p>

                    <div class="mt-4">
                        <h5>Campaign Timeline</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-2">
                                    <i class="bi bi-calendar-event text-primary"></i>
                                    <strong>Start Date:</strong><br />
                                    @Model.StartDate.ToString("MMMM dd, yyyy")
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-2">
                                    <i class="bi bi-calendar-x text-danger"></i>
                                    <strong>Deadline:</strong><br />
                                    @Model.Deadline.ToString("MMMM dd, yyyy")
                                </p>
                            </div>
                        </div>
                        @if (daysRemaining.HasValue && isActive)
                        {
                            <div class="alert alert-info mt-3">
                                <i class="bi bi-clock"></i> <strong>@daysRemaining days</strong> remaining to contribute
                            </div>
                        }
                        else if (isExpired)
                        {
                            <div class="alert alert-secondary mt-3">
                                <i class="bi bi-exclamation-circle"></i> This campaign has expired
                            </div>
                        }
                        else if (isCompleted)
                        {
                            <div class="alert alert-success mt-3">
                                <i class="bi bi-check-circle-fill"></i> This campaign has reached its funding goal!
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-building"></i> About the NGO</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @if (Model.NGO.Logo != null && Model.NGO.Logo.Length > 0)
                        {
                            var logoBase64 = Convert.ToBase64String(Model.NGO.Logo);
                            <div class="col-md-3 text-center">
                                <img src="data:@Model.NGO.LogoContentType;base64,@logoBase64" alt="@Model.NGO.Name" class="img-fluid rounded" style="max-height: 100px;">
                            </div>
                            <div class="col-md-9">
                                <h5>@Model.NGO.Name</h5>
                                <p>@Model.NGO.Description</p>
                                <p class="mb-0">
                                    <i class="bi bi-telephone"></i> <strong>Contact:</strong><br />
                                    @Model.NGO.ContactInformation
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12">
                                <h5>@Model.NGO.Name</h5>
                                <p>@Model.NGO.Description</p>
                                <p class="mb-0">
                                    <i class="bi bi-telephone"></i> <strong>Contact:</strong><br />
                                    @Model.NGO.ContactInformation
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 shadow-sm sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Fundraising Progress</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <h2 class="text-primary mb-0">₹@raisedAmount.ToString("N0")</h2>
                        <p class="text-muted mb-0">raised of ₹@Model.TargetAmount.ToString("N0") goal</p>
                    </div>

                    <div class="progress mb-3" style="height: 20px;">
                        <div class="progress-bar @(isCompleted ? "bg-success" : "bg-primary")" 
                             role="progressbar" 
                             style="width: @Math.Min(progressPercentage, 100)%" 
                             aria-valuenow="@progressPercentage" 
                             aria-valuemin="0" 
                             aria-valuemax="100">
                            @progressPercentage%
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <div class="text-center">
                            <h4 class="mb-0">@donorCount</h4>
                            <small class="text-muted">Donors</small>
                        </div>
                        <div class="text-center">
                            <h4 class="mb-0">@progressPercentage%</h4>
                            <small class="text-muted">Funded</small>
                        </div>
                        @if (daysRemaining.HasValue)
                        {
                            <div class="text-center">
                                <h4 class="mb-0">@daysRemaining</h4>
                                <small class="text-muted">Days Left</small>
                            </div>
                        }
                    </div>

                    @if (User.IsInRole("NGO") && Model.NGO.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <hr />
                        <div class="d-grid gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit Campaign
                            </a>
                            <a asp-action="MyCampaigns" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> My Campaigns
                            </a>
                        </div>
                    }
                    else if (User.IsInRole("Donor") && isActive && !isCompleted)
                    {
                        <hr />
                        <div class="d-grid gap-2">
                            <a asp-controller="Donation" asp-action="Create" asp-route-campaignId="@Model.Id" class="btn btn-success btn-lg">
                                <i class="bi bi-heart-fill"></i> Donate Now
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Campaigns
                            </a>
                        </div>
                    }
                    else if (!User.Identity.IsAuthenticated && isActive && !isCompleted)
                    {
                        <hr />
                        <div class="d-grid gap-2">
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Create", "Donation", new { campaignId = Model.Id })" class="btn btn-success btn-lg">
                                <i class="bi bi-heart-fill"></i> Donate Now
                            </a>
                            <small class="text-muted text-center mt-2">Login required to donate</small>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Campaigns
                            </a>
                        </div>
                    }
                    else
                    {
                        @if (!isActive || isCompleted || isExpired)
                        {
                            <hr />
                            <div class="alert alert-secondary">
                                <i class="bi bi-info-circle"></i> This campaign is no longer accepting donations.
                            </div>
                        }
                        <div class="d-grid">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Campaigns
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
