@{
    ViewData["Title"] = "CareFund - Empowering Change Together";
}

<style>
    /* Elegant Minimalist Design System */
    .landing-page {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }

    /* Hero Section - Clean & Spacious */
    .hero-wrapper {
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        padding: 6rem 0 5rem;
        position: relative;
        overflow: hidden;
    }

    .hero-wrapper::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent 0%, #3b82f6 50%, transparent 100%);
    }

    .hero-container {
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
        padding: 0 1.5rem;
    }

    .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #eff6ff;
        color: #3b82f6;
        padding: 0.625rem 1.25rem;
        border-radius: 50px;
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 2rem;
    }

    .hero-headline {
        font-size: 3.75rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.15;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
    }

    .hero-headline .highlight {
        color: #3b82f6;
        position: relative;
    }

    .hero-subtext {
        font-size: 1.25rem;
        color: #64748b;
        line-height: 1.7;
        margin-bottom: 3rem;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-cta-group {
        display: flex;
        gap: 1rem;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
    }

    .btn-primary-custom {
        background: #3b82f6;
        color: #ffffff;
        padding: 1rem 2.5rem;
        border-radius: 10px;
        font-size: 1.0625rem;
        font-weight: 600;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.25);
    }

    .btn-primary-custom:hover {
        background: #2563eb;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px 0 rgba(59, 130, 246, 0.35);
        color: #ffffff;
    }

    .btn-secondary-custom {
        background: transparent;
        color: #475569;
        padding: 1rem 2.5rem;
        border-radius: 10px;
        font-size: 1.0625rem;
        font-weight: 600;
        border: 2px solid #e2e8f0;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-secondary-custom:hover {
        border-color: #3b82f6;
        color: #3b82f6;
        background: #f0f9ff;
        transform: translateY(-2px);
    }

    /* Values Section - Icon Boxes */
    .values-section {
        padding: 5rem 0;
        background: #ffffff;
    }

    .values-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2.5rem;
    }

    .value-box {
        text-align: center;
        padding: 2rem 1.5rem;
        transition: transform 0.3s ease;
    }

    .value-box:hover {
        transform: translateY(-8px);
    }

    .value-icon-box {
        width: 80px;
        height: 80px;
        background: #f0f9ff;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        transition: all 0.3s ease;
    }

    .value-box:hover .value-icon-box {
        background: #3b82f6;
        transform: rotate(5deg) scale(1.05);
    }

    .value-icon-box i {
        font-size: 2.25rem;
        color: #3b82f6;
        transition: color 0.3s ease;
    }

    .value-box:hover .value-icon-box i {
        color: #ffffff;
    }

    .value-heading {
        font-size: 1.375rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.875rem;
    }

    .value-text {
        font-size: 1rem;
        color: #64748b;
        line-height: 1.7;
    }

    /* Steps Section - Horizontal Flow */
    .steps-section {
        padding: 5rem 0;
        background: #f8fafc;
    }

    .steps-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .section-intro {
        text-align: center;
        margin-bottom: 4rem;
    }

    .section-eyebrow {
        font-size: 0.875rem;
        font-weight: 700;
        color: #3b82f6;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 1rem;
    }

    .section-heading {
        font-size: 2.5rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1rem;
        letter-spacing: -0.01em;
    }

    .section-lead {
        font-size: 1.125rem;
        color: #64748b;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.7;
    }

    .steps-flow {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        position: relative;
    }

    .step-item {
        background: #ffffff;
        padding: 2.5rem 2rem;
        border-radius: 16px;
        border: 2px solid #e2e8f0;
        position: relative;
        transition: all 0.3s ease;
    }

    .step-item:hover {
        border-color: #3b82f6;
        box-shadow: 0 8px 24px rgba(59, 130, 246, 0.12);
    }

    .step-num {
        position: absolute;
        top: -16px;
        left: 2rem;
        width: 48px;
        height: 48px;
        background: #3b82f6;
        color: #ffffff;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .step-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.75rem;
        margin-top: 1rem;
    }

    .step-desc {
        font-size: 0.9375rem;
        color: #64748b;
        line-height: 1.7;
    }

    /* Impact Section - Statistics */
    .impact-section {
        padding: 5rem 0;
        background: #1e293b;
        color: #ffffff;
        position: relative;
        overflow: hidden;
    }

    .impact-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent 0%, #3b82f6 50%, transparent 100%);
    }

    .impact-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        text-align: center;
    }

    .impact-intro {
        margin-bottom: 4rem;
    }

    .impact-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        letter-spacing: -0.01em;
    }

    .impact-subtitle {
        font-size: 1.125rem;
        color: #94a3b8;
        max-width: 600px;
        margin: 0 auto;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 3rem;
    }

    .stat-box {
        padding: 1.5rem;
    }

    .stat-value {
        font-size: 3rem;
        font-weight: 800;
        color: #3b82f6;
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .stat-label {
        font-size: 1rem;
        color: #cbd5e1;
        font-weight: 500;
    }

    /* Final CTA Section */
    .final-cta-section {
        padding: 5rem 0;
        background: #ffffff;
        text-align: center;
    }

    .final-cta-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .final-cta-title {
        font-size: 2.75rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.5rem;
        letter-spacing: -0.01em;
    }

    .final-cta-text {
        font-size: 1.25rem;
        color: #64748b;
        margin-bottom: 2.5rem;
        line-height: 1.7;
    }

    .final-cta-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    /* Responsive Adjustments */
    @@media (max-width: 768px) {
        .hero-wrapper {
            padding: 4rem 0 3rem;
        }

        .hero-headline {
            font-size: 2.5rem;
        }

        .hero-subtext {
            font-size: 1.0625rem;
        }

        .values-section,
        .steps-section,
        .impact-section,
        .final-cta-section {
            padding: 3.5rem 0;
        }

        .section-heading,
        .impact-title,
        .final-cta-title {
            font-size: 2rem;
        }

        .values-grid,
        .steps-flow {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .stats-row {
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
        }

        .hero-cta-group,
        .final-cta-buttons {
            flex-direction: column;
            width: 100%;
        }

        .btn-primary-custom,
        .btn-secondary-custom {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="landing-page">
    <!-- Hero Section -->
    <div class="hero-wrapper">
        <div class="hero-container">
            <div class="hero-tag">
                <i class="bi bi-stars"></i>
                <span>Trusted by 10,000+ Donors Across India</span>
            </div>
            
            <h1 class="hero-headline">
                Support Causes That<br/>
                <span class="highlight">Matter to You</span>
            </h1>
            
            <p class="hero-subtext">
                Connect with verified NGOs and create real impact. Every donation is transparent, 
                secure, and makes a measurable difference in someone's life.
            </p>
            
            <div class="hero-cta-group">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Donor"))
                    {
                        <a asp-controller="Campaign" asp-action="Index" class="btn-primary-custom">
                            <i class="bi bi-grid-3x3-gap"></i>
                            Explore Campaigns
                        </a>
                        <a asp-controller="DonorDashboard" asp-action="Index" class="btn-secondary-custom">
                            <i class="bi bi-speedometer2"></i>
                            My Dashboard
                        </a>
                    }
                    else if (User.IsInRole("NGO"))
                    {
                        <a asp-controller="Campaign" asp-action="MyCampaigns" class="btn-primary-custom">
                            <i class="bi bi-megaphone"></i>
                            My Campaigns
                        </a>
                        <a asp-controller="Campaign" asp-action="Create" class="btn-secondary-custom">
                            <i class="bi bi-plus-lg"></i>
                            Create New Campaign
                        </a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn-primary-custom">
                            <i class="bi bi-shield-check"></i>
                            Admin Dashboard
                        </a>
                    }
                }
                else
                {
                    <a asp-controller="Campaign" asp-action="Index" class="btn-primary-custom">
                        <i class="bi bi-grid-3x3-gap"></i>
                        Explore Campaigns
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn-secondary-custom">
                        <i class="bi bi-arrow-right"></i>
                        Get Started
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Values Section -->
    <div class="values-section">
        <div class="values-container">
            <div class="values-grid">
                <div class="value-box">
                    <div class="value-icon-box">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <h3 class="value-heading">Verified Organizations</h3>
                    <p class="value-text">
                        Every NGO undergoes rigorous verification. Documentation, credentials, and registration 
                        are thoroughly reviewed by our team.
                    </p>
                </div>

                <div class="value-box">
                    <div class="value-icon-box">
                        <i class="bi bi-eye-fill"></i>
                    </div>
                    <h3 class="value-heading">Complete Transparency</h3>
                    <p class="value-text">
                        Track your donations in real-time. View detailed campaign progress, receipts, 
                        and exactly where your money goes.
                    </p>
                </div>

                <div class="value-box">
                    <div class="value-icon-box">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h3 class="value-heading">Secure Payments</h3>
                    <p class="value-text">
                        Bank-grade security with Razorpay integration. Your payment data is encrypted 
                        and your privacy is always protected.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Steps Section -->
    <div class="steps-section">
        <div class="steps-container">
            <div class="section-intro">
                <div class="section-eyebrow">How It Works</div>
                <h2 class="section-heading">Start Making Impact in 3 Simple Steps</h2>
                <p class="section-lead">
                    Our platform makes it easy to support causes you care about. 
                    Join thousands of donors creating real change.
                </p>
            </div>

            <div class="steps-flow">
                <div class="step-item">
                    <div class="step-num">1</div>
                    <h3 class="step-title">Browse Campaigns</h3>
                    <p class="step-desc">
                        Explore verified campaigns across education, healthcare, environment, 
                        and more. Filter by location, category, or goal amount.
                    </p>
                </div>

                <div class="step-item">
                    <div class="step-num">2</div>
                    <h3 class="step-title">Make Secure Donation</h3>
                    <p class="step-desc">
                        Choose your amount and donate securely through Razorpay. 
                        Get instant confirmation with a digital receipt via email.
                    </p>
                </div>

                <div class="step-item">
                    <div class="step-num">3</div>
                    <h3 class="step-title">Track Your Impact</h3>
                    <p class="step-desc">
                        Monitor campaign progress from your dashboard. View donation history 
                        and download receipts anytime you need.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Impact Section -->
    <div class="impact-section">
        <div class="impact-container">
            <div class="impact-intro">
                <h2 class="impact-title">Our Growing Impact</h2>
                <p class="impact-subtitle">
                    Join a community of changemakers supporting verified causes across India
                </p>
            </div>

            <div class="stats-row">
                <div class="stat-box">
                    <div class="stat-value">500+</div>
                    <div class="stat-label">Verified NGOs</div>
                </div>

                <div class="stat-box">
                    <div class="stat-value">10K+</div>
                    <div class="stat-label">Active Donors</div>
                </div>

                <div class="stat-box">
                    <div class="stat-value">₹5Cr+</div>
                    <div class="stat-label">Funds Raised</div>
                </div>

                <div class="stat-box">
                    <div class="stat-value">1000+</div>
                    <div class="stat-label">Successful Campaigns</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Final CTA Section -->
    <div class="final-cta-section">
        <div class="final-cta-container">
            <h2 class="final-cta-title">Ready to Create Change?</h2>
            <p class="final-cta-text">
                Join thousands of donors making a real difference. Browse active campaigns 
                and start your impact journey today.
            </p>
            
            <div class="final-cta-buttons">
                <a asp-controller="Campaign" asp-action="Index" class="btn-primary-custom">
                    <i class="bi bi-search"></i>
                    Browse Active Campaigns
                </a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn-secondary-custom">
                        <i class="bi bi-person-plus"></i>
                        Create Free Account
                    </a>
                }
            </div>
        </div>
    </div>
</div>
