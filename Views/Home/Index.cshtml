@{
    ViewData["Title"] = "CareFund - Support Verified NGOs";
}

<style>
    /* Hero Section - Refined and Balanced */
    .hero-section {
        padding: 3rem 0 4rem;
        background: #ffffff;
        border-bottom: 1px solid #e9ecef;
    }
    
    .hero-eyebrow {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 1.5px;
        color: #3b82f6;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }
    
    .hero-title {
        font-size: 2.75rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 1rem;
        line-height: 1.2;
    }
    
    .hero-subtitle {
        font-size: 1.125rem;
        color: #6c757d;
        margin-bottom: 2rem;
        line-height: 1.6;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }
    
    .hero-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .hero-buttons .btn {
        padding: 0.75rem 1.75rem;
        font-size: 1rem;
        font-weight: 500;
        border-radius: 6px;
    }
    
    /* Trust/Value Section */
    .trust-section {
        padding: 4rem 0;
        background: #f8f9fa;
    }
    
    .trust-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        max-width: 1000px;
        margin: 0 auto;
    }
    
    .trust-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 2rem 1.5rem;
        text-align: center;
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    
    .trust-card:hover {
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.1);
        border-color: #3b82f6;
    }
    
    .trust-icon {
        font-size: 2.5rem;
        color: #3b82f6;
        margin-bottom: 1.25rem;
    }
    
    .trust-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.75rem;
    }
    
    .trust-description {
        font-size: 0.9375rem;
        color: #6c757d;
        line-height: 1.6;
        flex-grow: 1;
    }
    
    /* How CareFund Works Section */
    .how-it-works-section {
        padding: 4rem 0;
        background: #ffffff;
    }
    
    .section-heading {
        text-align: center;
        margin-bottom: 3rem;
    }
    
    .section-title {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }
    
    .section-subtitle {
        font-size: 1rem;
        color: #6c757d;
    }
    
    .steps-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        max-width: 1000px;
        margin: 0 auto;
    }
    
    .step-card {
        text-align: center;
        position: relative;
    }
    
    .step-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background: #3b82f6;
        color: #ffffff;
        border-radius: 50%;
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
    }
    
    .step-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.75rem;
    }
    
    .step-description {
        font-size: 0.9375rem;
        color: #6c757d;
        line-height: 1.6;
    }
    
    /* Final CTA Section */
    .final-cta-section {
        padding: 3rem 0;
        background: #f8f9fa;
        border-top: 1px solid #e9ecef;
        text-align: center;
    }
    
    .cta-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 1.5rem;
    }
    
    .cta-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .cta-buttons .btn {
        padding: 0.75rem 1.75rem;
        font-size: 1rem;
        font-weight: 500;
        border-radius: 6px;
    }
    
    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero-section {
            padding: 2.5rem 0 3rem;
        }
        
        .hero-title {
            font-size: 2rem;
        }
        
        .hero-subtitle {
            font-size: 1rem;
        }
        
        .hero-buttons,
        .cta-buttons {
            flex-direction: column;
            align-items: stretch;
        }
        
        .hero-buttons .btn,
        .cta-buttons .btn {
            width: 100%;
        }
        
        .trust-section,
        .how-it-works-section,
        .final-cta-section {
            padding: 3rem 0;
        }
        
        .section-title {
            font-size: 1.75rem;
        }
        
        .trust-grid,
        .steps-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }
    }
    
    @@media (min-width: 769px) and (max-width: 991px) {
        .trust-grid,
        .steps-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<!-- Hero Section -->
<div class="hero-section">
    <div class="container text-center" style="max-width: 750px;">
        <div class="hero-eyebrow">SUPPORT • DONATE • MAKE AN IMPACT</div>
        <h1 class="hero-title">Make a Difference With CareFund</h1>
        <p class="hero-subtitle">
            Connect with verified NGOs and support causes that matter. Every donation creates real impact with complete transparency and security.
        </p>
        <div class="hero-buttons">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Donor"))
                {
                    <a asp-controller="Campaign" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-search"></i> Explore Campaigns
                    </a>
                    <a asp-controller="DonorDashboard" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-speedometer2"></i> My Dashboard
                    </a>
                }
                else if (User.IsInRole("NGO"))
                {
                    <a asp-controller="Campaign" asp-action="MyCampaigns" class="btn btn-primary">
                        <i class="bi bi-megaphone"></i> My Campaigns
                    </a>
                    <a asp-controller="Campaign" asp-action="Create" class="btn btn-outline-primary">
                        <i class="bi bi-plus-circle"></i> Create Campaign
                    </a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary">
                        <i class="bi bi-shield-check"></i> Admin Dashboard
                    </a>
                }
            }
            else
            {
                <a asp-controller="Campaign" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-search"></i> Explore Campaigns
                </a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary">
                    <i class="bi bi-person-plus"></i> Get Started
                </a>
            }
        </div>
    </div>
</div>

<!-- Trust/Value Section -->
<div class="trust-section">
    <div class="container">
        <div class="trust-grid">
            <div class="trust-card">
                <div class="trust-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h3 class="trust-title">Verified NGOs</h3>
                <p class="trust-description">
                    Every NGO is thoroughly verified by our admin team. Donate with confidence knowing your contribution reaches legitimate organizations.
                </p>
            </div>

            <div class="trust-card">
                <div class="trust-icon">
                    <i class="bi bi-heart"></i>
                </div>
                <h3 class="trust-title">Transparent Giving</h3>
                <p class="trust-description">
                    Track every donation with detailed receipts and real-time campaign progress. Complete transparency from start to finish.
                </p>
            </div>

            <div class="trust-card">
                <div class="trust-icon">
                    <i class="bi bi-lock"></i>
                </div>
                <h3 class="trust-title">Secure Donations</h3>
                <p class="trust-description">
                    Secure payment processing through Razorpay with instant digital receipts. Your payment information is always protected.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- How CareFund Works Section -->
<div class="how-it-works-section">
    <div class="container">
        <div class="section-heading">
            <h2 class="section-title">How CareFund Works</h2>
            <p class="section-subtitle">Three simple steps to create meaningful impact</p>
        </div>
        
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <h3 class="step-title">Find a Cause</h3>
                <p class="step-description">
                    Browse active campaigns from verified NGOs. Filter by category, location, or goal to find causes that resonate with you.
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">2</div>
                <h3 class="step-title">Make a Donation</h3>
                <p class="step-description">
                    Choose your contribution amount and complete secure payment through Razorpay. Receive instant confirmation and receipt via email.
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">3</div>
                <h3 class="step-title">Track Your Impact</h3>
                <p class="step-description">
                    Monitor campaign progress and view your complete donation history. Download receipts anytime from your dashboard.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Final CTA Section -->
<div class="final-cta-section">
    <div class="container">
        <h2 class="cta-title">Ready to Make a Difference?</h2>
        <div class="cta-buttons">
            <a asp-controller="Campaign" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-search"></i> Explore Campaigns
            </a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary">
                    <i class="bi bi-person-plus"></i> Create Account
                </a>
            }
        </div>
    </div>
</div>
